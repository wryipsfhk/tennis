# ID of your private JSONBin
JSONBIN_BIN_ID=your_bin_id_here

# Recommended: an Access Key limited to Bins Read and Bins Update
JSONBIN_ACCESS_KEY=your_access_key_here

# Leave the Master Key empty when using an Access Key
JSONBIN_MASTER_KEY=

# Random secret used to sign account sessions and short-lived video tickets
ACEPOINT_SESSION_SECRET=replace_with_at_least_24_random_characters
